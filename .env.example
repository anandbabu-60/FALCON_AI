APP_NAME="AI Research Collaboration Agent"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/research_agent
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174"]
REDIS_URL=redis://redis:6379/0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ResearchMind AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=25
ENABLE_DOCUMENT_INDEXING=true
